PORT=3000

# Onde ficam os pedidos (SQLite). ":memory:" para não gravar nada.
BALCAO_DATABASE=data/balcao.db

# Arquivo JSON com os negócios atendidos. Sem ele, sobem os 3 negócios de demonstração.
# Veja exemplo em negocios.example.json
# BALCAO_BUSINESSES=negocios.json

# Token do painel (24+ caracteres). Gere com: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
BALCAO_ADMIN_TOKEN=

# Segredo compartilhado com o n8n (32+ caracteres) e o endereço do webhook.
BALCAO_N8N_SECRET=
BALCAO_N8N_WEBHOOK_URL=http://localhost:5678/webhook/balcao

# Usado pelo n8n (o docker-compose repassa)
TELEGRAM_CHAT_ID=
